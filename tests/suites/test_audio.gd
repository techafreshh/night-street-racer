extends RefCounted
## Audio kit probes: generated WAVs, mixer math, autoload wiring, and
## per-vehicle 3D hooks. One of the per-area probe suites executed in
## fixed order by tests/run_all.gd; see that file for the PASS/FAIL +
## Results + exit-code contract.
## Add future probes here: append the func and its name to get_test_names().

const TestContext = preload("res://tests/support/test_context.gd")
const AudioMgr = preload("res://scripts/game/audio_manager.gd")

const CAR_SCENES: Array[String] = [
	"res://scenes/vehicles/vehicle_base.tscn",
	"res://scenes/vehicles/car_sedan.tscn",
	"res://scenes/vehicles/car_coupe.tscn",
	"res://scenes/vehicles/car_hatch.tscn",
	"res://scenes/vehicles/car_awd.tscn",
]

var ctx: TestContext

func _init(p_ctx: TestContext) -> void:
	ctx = p_ctx

func get_test_names() -> Array[String]:
	var names: Array[String] = [
		"test_audio_files_exist",
		"test_audio_wav_valid",
		"test_audio_manager_source",
		"test_audio_autoload",
		"test_audio_math",
		"test_audio_vehicle_hooks",
		"test_audio_vehicle_readout",
		"test_audio_credits",
	]
	return names

func test_audio_files_exist() -> bool:
	for name in ["engine.wav", "skid.wav", "wind.wav", "click.wav"]:
		ctx.check(FileAccess.file_exists("res://assets/audio/%s" % name), "assets/audio/%s exists" % name)
	ctx.check(FileAccess.file_exists("res://assets/audio/music_menu.wav"), "at least one music.* track exists (music_menu.wav)")
	ctx.check(FileAccess.file_exists("res://tools/make_audio.py"), "deterministic generator tools/make_audio.py exists")
	return true

func test_audio_wav_valid() -> bool:
	# Source bytes stay 22050 Hz mono 16-bit PCM (the importer's QOA
	# repack is engine-internal); parse the RIFF headers directly.
	var expectations := {
		"engine.wav": 44144,
		"skid.wav": 44144,
		"wind.wav": 88244,
		"click.wav": 5336,
		"music_menu.wav": 352844,
	}
	for name in expectations.keys():
		var path := "res://assets/audio/%s" % name
		var bytes := FileAccess.get_file_as_bytes(path)
		ctx.check(bytes.size() == int(expectations[name]), "%s is the generated byte count (got %d)" % [name, bytes.size()])
		if bytes.size() < 44:
			continue
		ctx.check(bytes.slice(0, 4) == PackedByteArray([0x52, 0x49, 0x46, 0x46]), "%s has a RIFF header" % name)
		ctx.check(bytes.slice(8, 12) == PackedByteArray([0x57, 0x41, 0x56, 0x45]), "%s is a WAVE file" % name)
		ctx.check(bytes.decode_u16(22) == 1, "%s is mono" % name)
		ctx.check(bytes.decode_u32(24) == 22050, "%s mixes at 22050 Hz" % name)
		ctx.check(bytes.decode_u16(34) == 16, "%s is 16-bit PCM" % name)
		ctx.check(bytes.decode_u32(40) == bytes.size() - 44, "%s header matches its data chunk" % name)
		var stream := load(path) as AudioStreamWAV
		ctx.check(stream != null, "%s loads as AudioStreamWAV" % name)
		if stream == null:
			continue
		ctx.check(stream.mix_rate == 22050, "%s imports at 22050 Hz (got %d)" % [name, stream.mix_rate])
		ctx.check(not stream.stereo, "%s imports as mono" % name)
		ctx.check(stream.get_data().size() > 1000, "%s imports non-empty audio (%d bytes)" % [name, stream.get_data().size()])
	return true

func test_audio_manager_source() -> bool:
	ctx.check(FileAccess.file_exists("res://scripts/game/audio_manager.gd"), "scripts/game/audio_manager.gd exists")
	var src := FileAccess.get_file_as_string("res://scripts/game/audio_manager.gd")
	for token in ["AUDIO_READY", "engine_pitch", "skid_gain", "wind_gain", "play_click", "start_menu_music", "duck_music_for_race", "register_vehicle", "unregister_vehicle", "LOOP_FORWARD"]:
		ctx.check(src.contains(token), "audio_manager.gd contains %s" % token)
	for bus in ["&\"Music\"", "&\"SFX\""]:
		ctx.check(src.contains(bus), "audio_manager.gd routes to the %s bus" % bus)
	ctx.check(src.contains("/root/Settings") or src.contains("Settings"), "audio mixer defers levels to Settings buses")
	return true

func test_audio_autoload() -> bool:
	var project := FileAccess.get_file_as_string("res://project.godot")
	var settings_at := project.find("Settings=")
	var audio_at := project.find("AudioManager=")
	ctx.check(settings_at >= 0, "project.godot keeps the Settings autoload")
	ctx.check(audio_at >= 0, "project.godot registers the AudioManager autoload")
	ctx.check(audio_at > settings_at, "AudioManager autoload lands after Settings")
	ctx.check(project.contains("res://scripts/game/audio_manager.gd"), "autoload points at scripts/game/audio_manager.gd")
	return true

func test_audio_math() -> bool:
	ctx.check(absf(AudioMgr.engine_pitch(800.0, 7200.0) - 0.6) < 0.001, "idle maps to pitch 0.6 (got %.3f)" % AudioMgr.engine_pitch(800.0, 7200.0))
	ctx.check(absf(AudioMgr.engine_pitch(7200.0, 7200.0) - 2.0) < 0.001, "redline maps to pitch 2.0 (got %.3f)" % AudioMgr.engine_pitch(7200.0, 7200.0))
	var mid := AudioMgr.engine_pitch(4000.0, 7200.0)
	ctx.check(absf(mid - 1.3) < 0.01, "mid rpm maps to pitch ~1.3 (got %.3f)" % mid)
	ctx.check(AudioMgr.engine_pitch(0.0, 7200.0) == 0.6, "below-idle clamps to 0.6")
	ctx.check(AudioMgr.engine_pitch(99999.0, 7200.0) == 2.0, "over-rev clamps to 2.0")
	ctx.check(AudioMgr.engine_pitch(800.0, 800.0) == 0.6, "degenerate span guards to 0.6")
	ctx.check(AudioMgr.skid_gain(0.0) == 0.0, "standstill skid gain is 0")
	ctx.check(AudioMgr.skid_gain(0.19) == 0.0, "sub-threshold slip stays silent")
	ctx.check(AudioMgr.skid_gain(0.20) == 0.0, "threshold slip stays silent")
	ctx.check(AudioMgr.skid_gain(0.35) > 0.0 and AudioMgr.skid_gain(0.35) < 1.0, "mid slip fades in (got %.3f)" % AudioMgr.skid_gain(0.35))
	ctx.check(AudioMgr.skid_gain(0.50) == 1.0, "full slip reaches gain 1")
	ctx.check(AudioMgr.skid_gain(2.0) == 1.0, "wild slip clamps to gain 1")
	ctx.check(AudioMgr.wind_gain(0.0) == 0.0, "standstill wind gain is 0")
	ctx.check(absf(AudioMgr.wind_gain(20.0) - 0.5) < 0.001, "half speed maps to gain 0.5 (got %.3f)" % AudioMgr.wind_gain(20.0))
	ctx.check(AudioMgr.wind_gain(40.0) == 1.0, "40 m/s maps to gain 1")
	ctx.check(AudioMgr.wind_gain(120.0) == 1.0, "beyond-full speed clamps to gain 1")
	return true

func test_audio_vehicle_hooks() -> bool:
	for path in CAR_SCENES:
		var packed := load(path) as PackedScene
		ctx.check(packed != null, "%s loads as PackedScene" % path)
		if packed == null:
			continue
		var inst := packed.instantiate()
		ctx.check(inst != null, "%s instantiates" % path)
		if inst == null:
			continue
		for hook in ["EngineAudio", "SkidAudio", "WindAudio"]:
			var player := inst.get_node_or_null(hook) as AudioStreamPlayer3D
			ctx.check(player != null, "%s carries a %s hook" % [path.get_file(), hook])
			if player == null:
				continue
			ctx.check(player.bus == &"SFX", "%s %s rides the SFX bus" % [path.get_file(), hook])
			ctx.check(player.stream != null, "%s %s has a stream" % [path.get_file(), hook])
			if player.stream != null:
				ctx.check(player.stream is AudioStreamWAV, "%s %s streams a WAV" % [path.get_file(), hook])
		inst.free()
	var ai := load("res://scenes/vehicles/ai_car.tscn") as PackedScene
	if ai != null:
		var inst := ai.instantiate()
		ctx.check(inst.get_node_or_null("EngineAudio") == null, "AI cars stay silent by design")
		inst.free()
	return true

func test_audio_vehicle_readout() -> bool:
	var packed := load("res://scenes/vehicles/vehicle_base.tscn") as PackedScene
	ctx.check(packed != null, "vehicle scene loads for the skid readout check")
	if packed == null:
		return true
	var inst := packed.instantiate() as VehicleController
	ctx.check(inst != null, "vehicle instantiates for the skid readout check")
	if inst == null:
		return true
	ctx.check(inst.get("slip_intensity") is float, "vehicle exposes a slip_intensity readout")
	if inst.get("slip_intensity") is float:
		ctx.check(float(inst.get("slip_intensity")) == 0.0, "slip_intensity idles at 0.0")
	inst.free()
	var src := FileAccess.get_file_as_string("res://scripts/vehicles/vehicle_controller.gd")
	ctx.check(src.contains("slip_intensity"), "vehicle_controller.gd tracks slip_intensity")
	ctx.check(src.contains("register_vehicle"), "player cars register with the mixer")
	var car := await ctx._spawn_car(Vector3(0, 0.9, 0))
	for i in 10:
		await ctx.tree.physics_frame
	ctx.check(car.get("slip_intensity") is float, "live car keeps the slip readout")
	if car.get("slip_intensity") is float:
		ctx.check(float(car.get("slip_intensity")) >= 0.0, "live slip readout stays non-negative (got %.3f)" % float(car.get("slip_intensity")))
	ctx.check(FileAccess.file_exists("res://scripts/game/audio_manager.gd"), "mixer script present for the live check")
	await ctx._despawn_car()
	return true

func test_audio_credits() -> bool:
	ctx.check(FileAccess.file_exists("res://docs/CREDITS"), "docs/CREDITS exists")
	var credits := FileAccess.get_file_as_string("res://docs/CREDITS")
	for token in ["engine.wav", "skid.wav", "wind.wav", "click.wav", "music_menu.wav"]:
		ctx.check(credits.contains(token), "CREDITS attributes %s" % token)
	ctx.check(credits.contains("CC0"), "CREDITS marks the audio kit CC0")
	ctx.check(credits.contains("No third-party file is vendored"), "CREDITS states no third-party audio is vendored")
	return true
